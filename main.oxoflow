# ---------------------------------------------------------------------------
# Joint germline genotyping — upstream subworkflows/local/
# bam_joint_calling_germline_gatk (params.joint_germline=true):
#   GATK4_HAPLOTYPECALLER (-ERC GVCF) -> GATK4_GENOMICSDBIMPORT
#   -> GATK4_GENOTYPEGVCFS -> BCFTOOLS_SORT -> GATK4_MERGEVCFS (joint_germline.vcf.gz)
#   -> GATK4_VARIANTRECALIBRATOR SNP + INDEL -> GATK4_APPLYVQSR SNP + INDEL
#   -> joint VCF_QC (bcftools + vcftools) + ENSEMBLVEP_VEP -> MULTIQC.
# The port runs without interval scatter: one whole-genome interval is built
# from the fasta .fai (upstream: per-contig intervals from BED_PREPARE_INTERVALS)
# and the sort/merge steps are single-file pass-throughs.
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_haplotypecaller_gvcf"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.g.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.g.vcf.gz.tbi",
]
description = "HaplotypeCaller in GVCF mode (nf-core GATK4_HAPLOTYPECALLER -ERC GVCF; joint_germline=true branch)"
when = "config.call_haplotypecaller && config.joint_germline && !config.scatter_gatk"
log = "logs/gatk_haplotypecaller_gvcf.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" HaplotypeCaller --input {input[0]} --output {sample}.haplotypecaller.g.vcf.gz --reference reference.fasta --native-pair-hmm-threads 2 --dbsnp $(basename {config.dbsnp}) --tmp-dir . --pcr-indel-model {config.gatk_pcr_indel_model} -ERC GVCF
mv {sample}.haplotypecaller.g.vcf.gz {sample}.haplotypecaller.g.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_genomicsdbimport"
input = ["{config.fasta_fai}"]
output = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.joint/callset.json"]
description = "Import per-sample GVCFs into a GenomicsDB workspace (nf-core GATK4_GENOMICSDBIMPORT; single whole-genome interval from the .fai — see section note)"
when = "config.call_haplotypecaller && config.joint_germline && !config.scatter_gatk"
log = "logs/gatk_genomicsdbimport.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta_fai} ./reference.fasta.fai
awk '{{print $1"\\t0\\t"$2}}' reference.fasta.fai > {config.joint_interval_name}.bed
GVCFS=""
for v in {config.out_dir}/variant_calling/haplotypecaller/*/*.haplotypecaller.g.vcf.gz; do GVCFS="$GVCFS --variant $v"; done
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" GenomicsDBImport $GVCFS --genomicsdb-workspace-path {config.joint_interval_name}.joint --intervals {config.joint_interval_name}.bed --genomicsdb-shared-posixfs-optimizations true --tmp-dir .
mv {config.joint_interval_name}.joint {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_genotypegvcfs"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.joint/callset.json"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.vcf.gz.tbi",
]
description = "Joint genotyping of the GenomicsDB workspace (nf-core GATK4_GENOTYPEGVCFS; output = '{intervals_name}.vcf.gz' upstream)"
when = "config.call_haplotypecaller && config.joint_germline && !config.scatter_gatk"
log = "logs/gatk_genotypegvcfs.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" GenotypeGVCFs --variant gendb://{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.joint --output {config.joint_interval_name}.vcf.gz --reference reference.fasta --dbsnp $(basename {config.dbsnp}) --genomicsdb-shared-posixfs-optimizations true --tmp-dir .
mv {config.joint_interval_name}.vcf.gz {config.joint_interval_name}.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "bcftools_sort_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.sort.vcf.gz"]
description = "Sort the joint-genotyped VCF (nf-core BCFTOOLS_SORT, ext.prefix = vcf.baseName - '.vcf' + '.sort'; single-file pass-through without interval scatter)"
when = "config.call_haplotypecaller && config.joint_germline && !config.scatter_gatk"
log = "logs/bcftools_sort_joint.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
bcftools sort --output {config.joint_interval_name}.sort.vcf.gz --temp-dir . --output-type z {input[0]}
mv {config.joint_interval_name}.sort.vcf.gz {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "gatk_mergevcfs_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/{config.joint_interval_name}.sort.vcf.gz"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz.tbi",
]
description = "Merge the per-interval joint VCFs (nf-core GATK4_MERGEVCFS, ext.prefix 'joint_germline')"
when = "config.call_haplotypecaller && config.joint_germline && !config.scatter_gatk"
log = "logs/gatk_mergevcfs_joint.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" MergeVcfs $(for v in {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/*.sort.vcf.gz; do echo -n "--INPUT $v "; done) --OUTPUT joint_germline.vcf.gz --TMP_DIR .
mv joint_germline.vcf.gz joint_germline.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_variantrecalibrator_snp"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.recal",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.recal.idx",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.tranches",
]
description = "VQSR SNP recalibration of the joint VCF (nf-core GATK4_VARIANTRECALIBRATOR SNP; dbsnp + 1000G omni2.5 resources from conf/igenomes.config; not published upstream — kept for DAG handoff)"
when = "config.call_haplotypecaller && config.joint_germline"
log = "logs/gatk_variantrecalibrator_snp.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
cp -L {config.known_snps} {config.known_snps_tbi} .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" VariantRecalibrator --variant {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz --output joint_variant_calling_SNP.recal --tranches-file joint_variant_calling_SNP.tranches --reference reference.fasta --tmp-dir . --resource:1000G,known=false,training=true,truth=true,prior=10.0 $(basename {config.known_snps}) --resource:dbsnp,known=false,training=true,truth=false,prior=2.0 $(basename {config.dbsnp}) -an QD -an MQ -an MQRankSum -an ReadPosRankSum -an FS -an SOR -mode SNP
mv joint_variant_calling_SNP.recal joint_variant_calling_SNP.recal.idx joint_variant_calling_SNP.tranches {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_variantrecalibrator_indel"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.recal",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.recal.idx",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.tranches",
]
description = "VQSR INDEL recalibration of the joint VCF (nf-core GATK4_VARIANTRECALIBRATOR INDEL; gatk + mills known-indels resources; not published upstream — kept for DAG handoff)"
when = "config.call_haplotypecaller && config.joint_germline"
log = "logs/gatk_variantrecalibrator_indel.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
SITES=""
for v in $(echo {config.known_indels} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
    case "$(basename "$v")" in
        Mills*) SITES="$SITES --resource:mills,known=false,training=true,truth=true,prior=10.0 $(basename "$v")" ;;
        *)      SITES="$SITES --resource:gatk,known=false,training=true,truth=true,prior=10.0 $(basename "$v")" ;;
    esac
done
for v in $(echo {config.known_indels_tbi} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
done
SITES="$SITES --resource:dbsnp,known=false,training=true,truth=false,prior=2.0 $(basename {config.dbsnp})"
cp -L {config.dbsnp} {config.dbsnp_tbi} .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" VariantRecalibrator --variant {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz --output joint_variant_calling_INDEL.recal --tranches-file joint_variant_calling_INDEL.tranches --reference reference.fasta --tmp-dir . $SITES -an QD -an MQRankSum -an ReadPosRankSum -an FS -an SOR -an DP -mode INDEL
mv joint_variant_calling_INDEL.recal joint_variant_calling_INDEL.recal.idx joint_variant_calling_INDEL.tranches {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_applyvqsr_snp"
input = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.recal",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.recal.idx",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.tranches",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/recalibrated_joint_variant_calling_SNP.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/recalibrated_joint_variant_calling_SNP.vcf.gz.tbi",
]
description = "Apply VQSR SNP recalibration (nf-core GATK4_APPLYVQSR SNP, --truth-sensitivity-filter-level 99.9; ext.prefix 'recalibrated_joint_variant_calling_SNP'; not published upstream — kept for DAG handoff)"
when = "config.call_haplotypecaller && config.joint_germline"
log = "logs/gatk_applyvqsr_snp.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz* .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" ApplyVQSR --variant joint_germline.vcf.gz --output recalibrated_joint_variant_calling_SNP.vcf.gz --reference reference.fasta --tranches-file {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.tranches --recal-file {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_SNP.recal --tmp-dir . --truth-sensitivity-filter-level 99.9 -mode SNP
mv recalibrated_joint_variant_calling_SNP.vcf.gz recalibrated_joint_variant_calling_SNP.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_applyvqsr_indel"
input = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/recalibrated_joint_variant_calling_SNP.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.recal",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.recal.idx",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.tranches",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz.tbi",
]
description = "Apply VQSR INDEL recalibration to the SNP-recalibrated joint VCF (nf-core GATK4_APPLYVQSR INDEL; ext.prefix 'joint_germline_recalibrated' — the final published joint VCF)"
when = "config.call_haplotypecaller && config.joint_germline"
log = "logs/gatk_applyvqsr_indel.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/recalibrated_joint_variant_calling_SNP.vcf.gz* .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" ApplyVQSR --variant recalibrated_joint_variant_calling_SNP.vcf.gz --output joint_germline_recalibrated.vcf.gz --reference reference.fasta --tranches-file {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.tranches --recal-file {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_variant_calling_INDEL.recal --tmp-dir . --truth-sensitivity-filter-level 99.9 -mode INDEL
mv joint_germline_recalibrated.vcf.gz joint_germline_recalibrated.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

# Joint VCF QC + VEP — VCF_QC_BCFTOOLS_VCFTOOLS and ENSEMBLVEP_VEP on the
# final VQSR'd joint VCF (upstream: the joint VCF replaces the per-sample
# filtered VCF in vcf_all, so the per-sample QC/VEP rules above are gated
# off in joint mode and these cohort rules take over).
[[rules]]
name = "bcftools_stats_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz"]
output = ["{config.out_dir}/reports/bcftools/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.bcftools_stats.txt"]
description = "VCF QC stats on the recalibrated joint VCF (nf-core BCFTOOLS_STATS on vcf_all)"
when = "config.call_haplotypecaller && config.joint_germline && !config.skip_bcftools"
log = "logs/bcftools_stats_joint.log"
shell = """
mkdir -p {config.out_dir}/reports/bcftools/haplotypecaller/joint_variant_calling
bcftools stats {input[0]} > joint_germline_recalibrated.bcftools_stats.txt
mv joint_germline_recalibrated.bcftools_stats.txt {config.out_dir}/reports/bcftools/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "vcftools_tstv_count_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.TsTv.count"]
description = "VCF QC: transition/transversion by count on the recalibrated joint VCF (nf-core VCFTOOLS_TSTV_COUNT)"
when = "config.call_haplotypecaller && config.joint_germline && !config.skip_vcftools"
log = "logs/vcftools_tstv_count_joint.log"
shell = """
mkdir -p {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling
vcftools --gzvcf {input[0]} --TsTv-by-count --out joint_germline_recalibrated
mv joint_germline_recalibrated.TsTv.count {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/vcftools:0.1.17--pl5321h077b44d_0"

[[rules]]
name = "vcftools_tstv_qual_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.TsTv.qual"]
description = "VCF QC: transition/transversion by quality on the recalibrated joint VCF (nf-core VCFTOOLS_TSTV_QUAL)"
when = "config.call_haplotypecaller && config.joint_germline && !config.skip_vcftools"
log = "logs/vcftools_tstv_qual_joint.log"
shell = """
mkdir -p {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling
vcftools --gzvcf {input[0]} --TsTv-by-qual --out joint_germline_recalibrated
mv joint_germline_recalibrated.TsTv.qual {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/vcftools:0.1.17--pl5321h077b44d_0"

[[rules]]
name = "vcftools_filter_summary_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.FILTER.summary"]
description = "VCF QC: FILTER summary on the recalibrated joint VCF (nf-core VCFTOOLS_SUMMARY)"
when = "config.call_haplotypecaller && config.joint_germline && !config.skip_vcftools"
log = "logs/vcftools_filter_summary_joint.log"
shell = """
mkdir -p {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling
vcftools --gzvcf {input[0]} --FILTER-summary --out joint_germline_recalibrated
mv joint_germline_recalibrated.FILTER.summary {config.out_dir}/reports/vcftools/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/vcftools:0.1.17--pl5321h077b44d_0"

[[rules]]
name = "ensemblvep_vep_joint"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline_recalibrated.vcf.gz"]
output = [
  "{config.out_dir}/annotation/haplotypecaller/joint_variant_calling/joint_germline_recalibrated_VEP.ann.vcf.gz",
  "{config.out_dir}/annotation/haplotypecaller/joint_variant_calling/joint_germline_recalibrated_VEP.ann.vcf.gz.tbi",
  "{config.out_dir}/reports/EnsemblVEP/haplotypecaller/joint_variant_calling/joint_germline_recalibrated_VEP.ann.summary.html",
]
description = "VEP annotation of the recalibrated joint VCF (nf-core ENSEMBLVEP_VEP on vcf_all; requires VEP cache — gated on vep_cache_ready)"
when = "config.call_haplotypecaller && config.joint_germline && config.annotate_vep && config.vep_cache_ready"
log = "logs/ensemblvep_vep_joint.log"
shell = """
mkdir -p {config.out_dir}/annotation/haplotypecaller/joint_variant_calling {config.out_dir}/reports/EnsemblVEP/haplotypecaller/joint_variant_calling
vep -i {input[0]} -o joint_germline_recalibrated_VEP.ann.vcf.gz --stats_file joint_germline_recalibrated_VEP.ann.summary.html --vcf --compress_output bgzip --assembly {config.vep_genome} --species {config.vep_species} --cache --cache_version {config.vep_cache_version} --dir_cache {config.vep_dir_cache} --fork 6
tabix joint_germline_recalibrated_VEP.ann.vcf.gz
mv joint_germline_recalibrated_VEP.ann.vcf.gz joint_germline_recalibrated_VEP.ann.vcf.gz.tbi {config.out_dir}/annotation/haplotypecaller/joint_variant_calling/
mv joint_germline_recalibrated_VEP.ann.summary.html {config.out_dir}/reports/EnsemblVEP/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
conda = "envs/vep.yaml"

# ---------------------------------------------------------------------------
# Per-chromosome scatter/gather branch (optional, gated by scatter_gatk).
# Upstream PREPARE_INTERVALS (BUILD_INTERVALS gawk over the .fai ->
# CREATE_INTERVALS_BED duration-binned split -> TABIX_BGZIPTABIX) then
# scatters BQSR / ApplyBQSR / HaplotypeCaller / joint GenotypeGVCFs over the
# interval files and gathers (GATK4_GATHERBQSRREPORTS,
# CRAM/BAM_MERGE_INDEX_SAMTOOLS, GATK4_MERGEVCFS). The engine's scatter fan-out
# takes a static value list, so the port uses one interval per chromosome
# (config.chromosomes — keep it in sync with the fasta .fai) instead of the
# upstream duration-binned files; the gathers are exact, so results are
# identical to both the upstream scatter path and the port's single
# whole-genome jobs. Gather outputs reuse the non-scatter rules' paths —
# the two branches are mutually exclusive via when, all downstream rules
# are unchanged.
# ---------------------------------------------------------------------------
[[rules]]
name = "create_intervals_bed"
input = ["{config.fasta_fai}"]
output = ["{config.out_dir}/intervals/{chr}.bed"]
description = "One 0-based BED interval per chromosome from the fasta .fai (upstream BUILD_INTERVALS + CREATE_INTERVALS_BED; per-chromosome instead of duration-binned windows)"
when = "config.scatter_gatk"
log = "logs/create_intervals_bed.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/intervals
cp -L {config.fasta_fai} ./reference.fasta.fai
awk -v c="{chr}" -v FS="\\t" -v OFS="\\t" '$1==c {print $1, "0", $2}' reference.fasta.fai > {chr}.bed
mv {chr}.bed {config.out_dir}/intervals/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/gawk:5.3.0"

[[rules]]
name = "tabix_interval"
input = ["{config.out_dir}/intervals/{chr}.bed"]
output = [
  "{config.out_dir}/intervals/{chr}.bed.gz",
  "{config.out_dir}/intervals/{chr}.bed.gz.tbi",
]
description = "bgzip + tabix the per-chromosome interval BED (upstream TABIX_BGZIPTABIX_INTERVAL_SPLIT)"
when = "config.scatter_gatk"
log = "logs/tabix_interval.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/intervals
cp -L {config.out_dir}/intervals/{chr}.bed .
bgzip -f {chr}.bed
tabix -p bed {chr}.bed.gz
mv {chr}.bed.gz {chr}.bed.gz.tbi {config.out_dir}/intervals/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "gatk_baserecalibrator_scatter"
input = [
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}",
  "{config.out_dir}/intervals/{chr}.bed.gz",
  "{config.out_dir}/intervals/{chr}.bed.gz.tbi",
]
output = ["{config.out_dir}/preprocessing/recal_table/{sample}/scatter/{chr}.table"]
description = "BaseRecalibrator per chromosome (nf-core GATK4_BASERECALIBRATOR with --intervals; scatter_gatk branch)"
when = "config.scatter_gatk"
log = "logs/gatk_baserecalibrator_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/preprocessing/recal_table/{sample}/scatter
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
cp -L {config.out_dir}/intervals/{chr}.bed.gz {config.out_dir}/intervals/{chr}.bed.gz.tbi .
SITES="--known-sites $(basename {config.dbsnp})"
for v in $(echo {config.known_indels} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
    SITES="$SITES --known-sites $(basename "$v")"
done
for v in $(echo {config.known_indels_tbi} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
done
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" BaseRecalibrator --input {input[0]} --output {chr}.table --reference reference.fasta $SITES --intervals {chr}.bed.gz --tmp-dir .
mv {chr}.table {config.out_dir}/preprocessing/recal_table/{sample}/scatter/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_gatherbqsrreports"
input = []
output = ["{config.out_dir}/preprocessing/recal_table/{sample}/{sample}.recal.table"]
description = "Merge the per-chromosome recalibration tables (nf-core GATK4_GATHERBQSRREPORTS; output path = non-scatter branch)"
when = "config.scatter_gatk"
log = "logs/gatk_gatherbqsrreports.log"
expand_inputs = [
  { pattern = "{config.out_dir}/preprocessing/recal_table/{sample}/scatter/{chr}.table", variables = { chr = "config.chromosomes" } }
]
shell = """
mkdir -p {config.out_dir}/preprocessing/recal_table/{sample}
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" GatherBQSRReports $(for t in {input}; do echo -n "--input $t "; done) --output {sample}.recal.table --tmp-dir .
mv {sample}.recal.table {config.out_dir}/preprocessing/recal_table/{sample}/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_applybqsr_scatter"
input = [
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}",
  "{config.out_dir}/preprocessing/recal_table/{sample}/{sample}.recal.table",
  "{config.out_dir}/intervals/{chr}.bed.gz",
]
output = ["{config.out_dir}/recalibrated/{sample}/scatter/{chr}.recal.{config.alignment_ext}"]
description = "ApplyBQSR per chromosome (nf-core GATK4_APPLYBQSR with --intervals; scatter_gatk branch)"
when = "config.scatter_gatk"
log = "logs/gatk_applybqsr_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/recalibrated/{sample}/scatter
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.out_dir}/intervals/{chr}.bed.gz .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" ApplyBQSR --input {input[0]} --output {chr}.recal.{config.alignment_ext} --reference reference.fasta --bqsr-recal-file {input[1]} --intervals {chr}.bed.gz --tmp-dir .
mv {chr}.recal.{config.alignment_ext} {config.out_dir}/recalibrated/{sample}/scatter/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "merge_index_samtools"
input = []
output = [
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}",
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.recal_index_ext}",
]
description = "Merge the per-chromosome recalibrated alignments + index (upstream CRAM/BAM_MERGE_INDEX_SAMTOOLS; output paths = non-scatter branch)"
when = "config.scatter_gatk"
log = "logs/merge_index_samtools.log"
expand_inputs = [
  { pattern = "{config.out_dir}/recalibrated/{sample}/scatter/{chr}.recal.{config.alignment_ext}", variables = { chr = "config.chromosomes" } }
]
shell = """
mkdir -p {config.out_dir}/recalibrated/{sample}
cp -L {config.fasta} ./reference.fasta
samtools merge --threads {effective_threads} --reference reference.fasta {sample}.recal.{config.alignment_ext} {input}
samtools index {sample}.recal.{config.alignment_ext}
mv {sample}.recal.{config.alignment_ext} {sample}.recal.{config.recal_index_ext} {config.out_dir}/recalibrated/{sample}/
"""

[rules.resources]
threads = 4
memory = "8G"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "gatk_haplotypecaller_scatter"
input = [
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}",
  "{config.out_dir}/intervals/{chr}.bed.gz",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/{chr}.haplotypecaller.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/{chr}.haplotypecaller.vcf.gz.tbi",
]
description = "HaplotypeCaller per chromosome (nf-core GATK4_HAPLOTYPECALLER with --intervals; scatter_gatk branch)"
when = "config.scatter_gatk && !config.joint_germline"
log = "logs/gatk_haplotypecaller_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
cp -L {config.out_dir}/intervals/{chr}.bed.gz .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" HaplotypeCaller --input {input[0]} --output {chr}.haplotypecaller.vcf.gz --reference reference.fasta --native-pair-hmm-threads 2 --dbsnp $(basename {config.dbsnp}) --tmp-dir . --pcr-indel-model {config.gatk_pcr_indel_model} --intervals {chr}.bed.gz
mv {chr}.haplotypecaller.vcf.gz {chr}.haplotypecaller.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_mergevcfs_scatter"
input = []
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz.tbi",
]
description = "Merge the per-chromosome HaplotypeCaller VCFs (nf-core GATK4_MERGEVCFS; output paths = non-scatter branch)"
when = "config.scatter_gatk && !config.joint_germline"
log = "logs/gatk_mergevcfs_scatter.log"
expand_inputs = [
  { pattern = "{config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/{chr}.haplotypecaller.vcf.gz", variables = { chr = "config.chromosomes" } }
]
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" MergeVcfs $(for v in {input}; do echo -n "--INPUT $v "; done) --OUTPUT {sample}.haplotypecaller.vcf.gz --TMP_DIR .
tabix -f {sample}.haplotypecaller.vcf.gz
mv {sample}.haplotypecaller.vcf.gz {sample}.haplotypecaller.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

# Joint-mode scatter: HaplotypeCaller -ERC GVCF per chromosome ->
# GenomicsDBImport per chromosome -> GenotypeGVCFs per chromosome ->
# bcftools sort per chromosome -> MergeVcfs (same outputs as the
# non-scatter joint branch, so VQSR and the joint QC/VEP rules are unchanged)
[[rules]]
name = "gatk_haplotypecaller_gvcf_scatter"
input = [
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}",
  "{config.out_dir}/intervals/{chr}.bed.gz",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/{chr}.haplotypecaller.g.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/{chr}.haplotypecaller.g.vcf.gz.tbi",
]
description = "HaplotypeCaller in GVCF mode per chromosome (nf-core GATK4_HAPLOTYPECALLER -ERC GVCF with --intervals; joint scatter_gatk branch)"
when = "config.scatter_gatk && config.joint_germline"
log = "logs/gatk_haplotypecaller_gvcf_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
cp -L {config.out_dir}/intervals/{chr}.bed.gz .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" HaplotypeCaller --input {input[0]} --output {chr}.haplotypecaller.g.vcf.gz --reference reference.fasta --native-pair-hmm-threads 2 --dbsnp $(basename {config.dbsnp}) --tmp-dir . --pcr-indel-model {config.gatk_pcr_indel_model} -ERC GVCF --intervals {chr}.bed.gz
mv {chr}.haplotypecaller.g.vcf.gz {chr}.haplotypecaller.g.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/scatter/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_genomicsdbimport_scatter"
input = ["{config.out_dir}/intervals/{chr}.bed.gz"]
output = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.joint/callset.json"]
description = "GenomicsDBImport per chromosome (nf-core GATK4_GENOMICSDBIMPORT with --intervals; joint scatter_gatk branch)"
when = "config.scatter_gatk && config.joint_germline"
log = "logs/gatk_genomicsdbimport_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter
cp -L {config.out_dir}/intervals/{chr}.bed.gz .
GVCFS=""
for v in {config.out_dir}/variant_calling/haplotypecaller/*/scatter/{chr}.haplotypecaller.g.vcf.gz; do GVCFS="$GVCFS --variant $v"; done
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" GenomicsDBImport $GVCFS --genomicsdb-workspace-path {chr}.joint --intervals {chr}.bed.gz --genomicsdb-shared-posixfs-optimizations true --tmp-dir .
mv {chr}.joint {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_genotypegvcfs_scatter"
input = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.joint/callset.json",
  "{config.out_dir}/intervals/{chr}.bed.gz",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.vcf.gz.tbi",
]
description = "GenotypeGVCFs per chromosome (nf-core GATK4_GENOTYPEGVCFS with --intervals; joint scatter_gatk branch)"
when = "config.scatter_gatk && config.joint_germline"
log = "logs/gatk_genotypegvcfs_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
cp -L {config.out_dir}/intervals/{chr}.bed.gz .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" GenotypeGVCFs --variant gendb://{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.joint --output {chr}.vcf.gz --reference reference.fasta --dbsnp $(basename {config.dbsnp}) --genomicsdb-shared-posixfs-optimizations true --intervals {chr}.bed.gz --tmp-dir .
mv {chr}.vcf.gz {chr}.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "bcftools_sort_joint_scatter"
input = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.sort.vcf.gz"]
description = "Sort the per-chromosome joint VCFs (nf-core BCFTOOLS_SORT; joint scatter_gatk branch)"
when = "config.scatter_gatk && config.joint_germline"
log = "logs/bcftools_sort_joint_scatter.log"
scatter = { variable = "chr", values_from = "config.chromosomes" }
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter
bcftools sort --output {chr}.sort.vcf.gz --temp-dir . --output-type z {input[0]}
mv {chr}.sort.vcf.gz {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "gatk_mergevcfs_joint_scatter"
input = []
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/joint_germline.vcf.gz.tbi",
]
description = "Merge the per-chromosome joint VCFs (nf-core GATK4_MERGEVCFS; output paths = non-scatter joint branch)"
when = "config.scatter_gatk && config.joint_germline"
log = "logs/gatk_mergevcfs_joint_scatter.log"
expand_inputs = [
  { pattern = "{config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/scatter/{chr}.sort.vcf.gz", variables = { chr = "config.chromosomes" } }
]
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" MergeVcfs $(for v in {input}; do echo -n "--INPUT $v "; done) --OUTPUT joint_germline.vcf.gz --TMP_DIR .
mv joint_germline.vcf.gz joint_germline.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/joint_variant_calling/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# MULTIQC — nf-core/multiqc module; scans the results directory with the
# upstream assets/multiqc_config.yml (fan-in over every report producer)
# ---------------------------------------------------------------------------
[[rules]]
name = "multiqc"
input = []
depends_on = [
  "fastqc",
  "fastp",
  "fastp_umi",
  "gatk_markduplicates",
  "gatk_markduplicates_bam",
  "mosdepth_md",
  "samtools_stats_md",
  "mosdepth_recal",
  "samtools_stats_recal",
  "gatk_cnnscorevariants",
  "gatk_filtervarianttranches",
  "bcftools_stats",
  "vcftools_tstv_count",
  "vcftools_tstv_qual",
  "vcftools_filter_summary",
  "ensemblvep_vep",
  "bcftools_stats_joint",
  "vcftools_tstv_count_joint",
  "vcftools_tstv_qual_joint",
  "vcftools_filter_summary_joint",
  "ensemblvep_vep_joint",
  "fgbio_groupreadsbyumi",
  "bcftools_mpileup_ngscheckmate",
  "ngscheckmate_ncm",
  "goleft_indexcov",
  "bcftools_stats_freebayes",
  "vcftools_tstv_count_freebayes",
  "vcftools_tstv_qual_freebayes",
  "vcftools_filter_summary_freebayes",
  "ensemblvep_vep_freebayes",
  "bcftools_stats_strelka",
  "vcftools_tstv_count_strelka",
  "vcftools_tstv_qual_strelka",
  "vcftools_filter_summary_strelka",
  "ensemblvep_vep_strelka",
  "bcftools_stats_mpileup",
  "vcftools_tstv_count_mpileup",
  "vcftools_tstv_qual_mpileup",
  "vcftools_filter_summary_mpileup",
  "ensemblvep_vep_mpileup",
  "bcftools_stats_deepvariant",
  "vcftools_tstv_count_deepvariant",
  "vcftools_tstv_qual_deepvariant",
  "vcftools_filter_summary_deepvariant",
  "ensemblvep_vep_deepvariant",
  "bcftools_stats_manta",
  "vcftools_tstv_count_manta",
  "vcftools_tstv_qual_manta",
  "vcftools_filter_summary_manta",
  "ensemblvep_vep_manta",
  "bcftools_stats_tiddit",
  "vcftools_tstv_count_tiddit",
  "vcftools_tstv_qual_tiddit",
  "vcftools_filter_summary_tiddit",
  "ensemblvep_vep_tiddit",
]
output = ["{config.out_dir}/multiqc_report.html"]
description = "Aggregate QC reports with MultiQC (nf-core MULTIQC)"
when = "!config.skip_multiqc"
shell = """
mkdir -p {config.out_dir}
cp -L assets/nf-core-sarek_logo_light.png {config.out_dir}/
cd {config.out_dir}
multiqc --force --config ../assets/multiqc_config.yml .
"""

[rules.resources]
threads = 4
memory = "12G"

[rules.environment]
conda = "envs/multiqc.yaml"
