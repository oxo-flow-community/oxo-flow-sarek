# ---------------------------------------------------------------------------
# ENSEMBLVEP_VEP — nf-core/ensemblvep/vep module
# (GRCh38: --assembly GRCh38 --species homo_sapiens --cache --cache_version 116
# --dir_cache /.vep; ext.args '--stats_file <id>_VEP.ann.summary.html --vcf';
# ext.prefix = vcf basename minus '.vcf' + '_VEP.ann'; tabix index after)
# ---------------------------------------------------------------------------
[[rules]]
name = "ensemblvep_vep"
input = ["{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.vcf.gz"]
output = [
  "{config.out_dir}/annotation/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered_VEP.ann.vcf.gz",
  "{config.out_dir}/annotation/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered_VEP.ann.vcf.gz.tbi",
  "{config.out_dir}/reports/EnsemblVEP/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered_VEP.ann.summary.html",
]
description = "VEP annotation of filtered germline variants (nf-core ENSEMBLVEP_VEP; requires VEP cache at vep_dir_cache — gated on vep_cache_ready)"
when = "config.call_haplotypecaller && !config.joint_germline && config.annotate_vep && config.vep_cache_ready"
shell = """
mkdir -p {config.out_dir}/annotation/haplotypecaller/{sample} {config.out_dir}/reports/EnsemblVEP/haplotypecaller/{sample}
vep -i {input[0]} -o {sample}.haplotypecaller.filtered_VEP.ann.vcf.gz --stats_file {sample}.haplotypecaller.filtered_VEP.ann.summary.html --vcf --compress_output bgzip --assembly {config.vep_genome} --species {config.vep_species} --cache --cache_version {config.vep_cache_version} --dir_cache {config.vep_dir_cache} --fork 6
tabix {sample}.haplotypecaller.filtered_VEP.ann.vcf.gz
mv {sample}.haplotypecaller.filtered_VEP.ann.vcf.gz {sample}.haplotypecaller.filtered_VEP.ann.vcf.gz.tbi {config.out_dir}/annotation/haplotypecaller/{sample}/
mv {sample}.haplotypecaller.filtered_VEP.ann.summary.html {config.out_dir}/reports/EnsemblVEP/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
conda = "envs/vep.yaml"

# ---------------------------------------------------------------------------
# Per-caller VCF_QC_BCFTOOLS_VCFTOOLS + ENSEMBLVEP_VEP — upstream runs the
# VCF_QC and VEP processes on every caller's published VCF (sarek.nf
# vcf_all channel: freebayes/strelka/mpileup/deepvariant/manta/tiddit +
# haplotypecaller + joint), so the QC/annotation fan-out is ported here one
# rule per caller. When-gated on the same call_* toggles as the callers
# themselves, so only VCFs that exist are consumed. Tiddit publishes an
# uncompressed .vcf — vcftools uses --vcf for it, --gzvcf for the others.
# ---------------------------------------------------------------------------
[[rules]]
name = "bcftools_stats_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
output = ["{config.out_dir}/reports/bcftools/freebayes/{sample}/{sample}.freebayes.filtered.bcftools_stats.txt"]
description = "VCF QC stats with bcftools on the freebayes VCF (nf-core BCFTOOLS_STATS)"
when = "config.call_freebayes && !config.skip_bcftools"
shell = """
mkdir -p {config.out_dir}/reports/bcftools/freebayes/{sample}
bcftools stats {input[0]} > {sample}.freebayes.filtered.bcftools_stats.txt
mv {sample}.freebayes.filtered.bcftools_stats.txt {config.out_dir}/reports/bcftools/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "vcftools_tstv_count_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/freebayes/{sample}/{sample}.freebayes.filtered.TsTv.count"]
description = "VCF QC: transition/transversion by count on the freebayes VCF (nf-core VCFTOOLS_TSTV_COUNT)"
when = "config.call_freebayes && !config.skip_vcftools"
shell = """
mkdir -p {config.out_dir}/reports/vcftools/freebayes/{sample}
vcftools --gzvcf {input[0]} --TsTv-by-count --out {sample}.freebayes.filtered
mv {sample}.freebayes.filtered.TsTv.count {config.out_dir}/reports/vcftools/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/vcftools:0.1.17--pl5321h077b44d_0"

[[rules]]
name = "vcftools_tstv_qual_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/freebayes/{sample}/{sample}.freebayes.filtered.TsTv.qual"]
