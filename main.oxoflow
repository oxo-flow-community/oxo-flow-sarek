# oxo-flow-sarek — WGS/WES germline variant calling
# oxo-flow port of nf-core/sarek @ 3.10.0 (default-parameters main execution path).
#
# Ported 2026-08-15, expanded 2026-08-26. See README.md fidelity table for the
# exact upstream mapping and every deviation. Upstream default path reproduced here:
#   FASTQC -> FASTP -> BWA_MEM -> GATK4_MARKDUPLICATES -> (mosdepth + samtools stats)
#   -> GATK4_BASERECALIBRATOR -> GATK4_APPLYBQSR -> (index + mosdepth + samtools stats)
#   -> GATK4_HAPLOTYPECALLER -> GATK4_CNNSCOREVARIANTS -> GATK4_FILTERVARIANTTRANCHES
#   -> (bcftools stats + vcftools x3) -> ENSEMBLVEP_VEP -> MULTIQC
#
# Optional upstream branches ported alongside the default path (all gated by
# config booleans, see README fidelity table):
#   PREPARE_GENOME reference building (bwa / bwa-mem2 index, dict, faidx),
#   aligner 'bwa-mem2', save_output_as_bam=true (BAM branch of MarkDuplicates),
#   UMI consensus preprocessing (fgbio FastqToBam -> GroupReadsByUmi ->
#   CallMolecularConsensusReads -> fastp), optional callers FreeBayes, Strelka2,
#   Manta, bcftools mpileup, TIDDIT, goleft indexcov (WGS only), DeepVariant,
#   NGSCheckMate, and joint germline genotyping (GenomicsDBImport ->
#   GenotypeGVCFs -> MergeVcfs -> VQSR SNP+INDEL -> ApplyVQSR -> QC + VEP).
#
# Engine note: cohort-level rules (multiqc pattern) use input = [] + depends_on
# and glob the results directory; per-sample callers use explicit input edges.

[workflow]
name = "oxo-flow-sarek"
version = "1.0.0"
description = "WGS/WES germline and somatic variant calling — oxo-flow port of nf-core/sarek 3.10.0: QC, trimming/splitting, BWA-MEM alignment, MarkDuplicates, BQSR, HaplotypeCaller, VEP annotation, MultiQC"
author = "oxo-flow-community"

# Upstream nextflow.config params that drive the default path. Every value is
# the upstream default (nf-core/sarek 3.10.0); `tools` is expressed as
# per-tool booleans below (upstream: params.tools = "haplotypecaller,vep").
[config]
out_dir = "results"
genome = "GRCh38"
aligner = "bwa-mem"
trim_fastq = false
split_fastq = 50000000          # fastp --split_by_lines = split_fastq * 4
length_required = 15
wes = false
save_output_as_bam = false      # CRAM output mode (upstream default)
joint_germline = false
gatk_pcr_indel_model = "CONSERVATIVE"
seq_platform = "ILLUMINA"
vep_genome = "GRCh38"
vep_species = "homo_sapiens"
# The VEP cache version must match the VEP binary in envs/vep.yaml
# (upstream's image pins 116; this env ships ensembl-vep 112, whose
# cache format is version-locked — a 116 cache is unreadable).
# The cache itself is user data (upstream bundles it in the container
# at /.vep; ~30GB for whole-genome GRCh38, or a gtf2vep subset) —
# the VEP rule gates on vep_cache_ready. Upstream fails hard without
# the cache; set the flag after placing it at vep_dir_cache (see
# README fidelity table).
vep_cache_version = 112
vep_dir_cache = "/.vep"
vep_cache_ready = false

# Sample metadata — mirrors tests/csv/3.0/fastq_single.csv (single-lane model:
# nf-core/sarek meta.id = "{sample}-{lane}", read-group ID = "{sample}.{lane}")
patient = "test"
sex = "XX"
status = 0
lane = "L1"

# tools / skip_tools equivalents (upstream comma-list params expressed as booleans)
call_haplotypecaller = true
annotate_vep = true
skip_fastqc = false
skip_mosdepth = false
skip_samtools = false
skip_bcftools = false
skip_vcftools = false
skip_multiqc = false

# Reference data (user-provided; GRCh38 GATK bundle layout from upstream
# conf/igenomes.config, substituted at port time)
fasta = "/data/references/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta"
fasta_fai = "/data/references/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai"
dict = "/data/references/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.dict"
bwa_index_dir = "/data/references/GRCh38/Sequence/BWAIndex/"
dbsnp = "/data/references/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz"
dbsnp_tbi = "/data/references/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz.tbi"
known_indels = [
  "/data/references/GRCh38/Annotation/GATKBundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz",
  "/data/references/GRCh38/Annotation/GATKBundle/Homo_sapiens_assembly38.known_indels.vcf.gz",
]
known_indels_tbi = [
  "/data/references/GRCh38/Annotation/GATKBundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi",
  "/data/references/GRCh38/Annotation/GATKBundle/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi",
]

# Optional branches (all default-off; upstream equivalents in parentheses)
# ---------------------------------------------------------------------------
# Reference preparation — upstream PREPARE_GENOME builds the BWA/BWAmem2
# indexes + .dict + .fai when the reference lacks them; the port gates this on
# prepare_reference and writes into results/reference/. Point bwa_index_dir /
# bwa_mem2_index_dir / fasta_fai / dict at the built files to use them.
prepare_reference = false
bwa_mem2_index_dir = "/data/references/GRCh38/Sequence/BWAmem2Index/"

# Optional callers (upstream --tools list, one boolean per tool)
call_freebayes = false
call_strelka = false
call_manta = false
call_mpileup = false
call_tiddit = false
call_indexcov = false       # upstream runs indexcov on WGS only (germline)
call_deepvariant = false
tools_ngscheckmate = false
freebayes_filter = 30        # upstream params.freebayes_filter
ngscheckmate_bed = "/data/references/GRCh38/Annotation/NGSCheckMate/SNP_GRCh38_hg38_wChr.bed"

# VQSR resources for joint germline (upstream conf/igenomes.config known_snps)
known_snps = "/data/references/GRCh38/Annotation/GATKBundle/1000G_omni2.5.hg38.vcf.gz"
known_snps_tbi = "/data/references/GRCh38/Annotation/GATKBundle/1000G_omni2.5.hg38.vcf.gz.tbi"

# Alignment-file mode: 'cram' (default) or 'bam' (when save_output_as_bam=true).
# recal_index_ext must match the mode ('cram.crai' vs 'bam.bai').
alignment_ext = "cram"
recal_index_ext = "cram.crai"

# UMI consensus preprocessing (upstream params.umi_read_structure, e.g.
# '3M2S+T' or '5M2S+T'; empty string disables the whole UMI chain)
umi_read_structure = ""
group_by_umi_strategy = "Adjacency"   # upstream params.group_by_umi_strategy

# Joint germline: the port runs without interval scatter; a single whole-genome
# interval is built from the fasta .fai (upstream: per-contig BED_PREPARE_INTERVALS)
joint_interval_name = "whole_genome"

# Optional per-chromosome scatter/gather branch (default off). When
# scatter_gatk = true, BQSR / ApplyBQSR / HaplotypeCaller (and the joint
# GenotypeGVCFs) run one job per chromosome and the per-chromosome outputs
# are gathered (GatherBQSRReports / samtools merge+index / MergeVcfs) —
# results identical to the single whole-genome job (gathers are exact), with
# per-chromosome parallelism. Upstream scatters over dynamic duration-binned
# interval files; the engine's scatter takes a static value list, so the port
# uses one interval per chromosome. Keep `chromosomes` in sync with the
# contigs of your fasta .fai (each entry must exist in the .fai).
scatter_gatk = false
chromosomes = [
  "chr1", "chr2", "chr3", "chr4", "chr5", "chr6", "chr7", "chr8", "chr9",
  "chr10", "chr11", "chr12", "chr13", "chr14", "chr15", "chr16", "chr17",
  "chr18", "chr19", "chr20", "chr21", "chr22", "chrX", "chrY", "chrM",
]

[[sample_groups]]
name = "cohort"
samples = ["test", "test2"]

# ---------------------------------------------------------------------------
# Reference preparation — upstream subworkflows/local/prepare_genome (runs
# when the reference files are not provided). The port gates all four on
# prepare_reference; outputs land in results/reference/ with fixed names
# (upstream uses the fasta basename; the bwa/bwa-mem2 rules find the index
# by extension, so the prefix is irrelevant). No engine DAG edges: the
# consuming rules read config.bwa_index_dir / fasta_fai / dict directly.
# ---------------------------------------------------------------------------
[[rules]]
name = "bwa_index"
input = ["{config.fasta}"]
output = [
  "{config.out_dir}/reference/bwa/index.amb",
  "{config.out_dir}/reference/bwa/index.ann",
  "{config.out_dir}/reference/bwa/index.bwt",
  "{config.out_dir}/reference/bwa/index.pac",
  "{config.out_dir}/reference/bwa/index.sa",
]
description = "BWA index of the reference fasta (nf-core BWA_INDEX; upstream prefix = fasta basename, port uses fixed 'index' — see README)"
when = "config.prepare_reference"
log = "logs/bwa_index.log"
shell = """
mkdir -p {config.out_dir}/reference/bwa
bwa index -p bwa/index {config.fasta}
mv bwa/index.amb bwa/index.ann bwa/index.bwt bwa/index.pac bwa/index.sa {config.out_dir}/reference/bwa/
"""

[rules.resources]
threads = 1
memory = "24G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/bwa_htslib_samtools:83b50ff84ead50d0"

# ---------------------------------------------------------------------------
[[rules]]
name = "bwamem2_index"
input = ["{config.fasta}"]
output = [
  "{config.out_dir}/reference/bwamem2/index.0123",
  "{config.out_dir}/reference/bwamem2/index.amb",
  "{config.out_dir}/reference/bwamem2/index.ann",
  "{config.out_dir}/reference/bwamem2/index.bwt.2bit.64",
  "{config.out_dir}/reference/bwamem2/index.pac",
]
description = "BWA-MEM2 index of the reference fasta (nf-core BWAMEM2_INDEX; fixed 'index' prefix, see README)"
when = "config.prepare_reference"
log = "logs/bwamem2_index.log"
shell = """
mkdir -p {config.out_dir}/reference/bwamem2
bwa-mem2 index -p bwamem2/index {config.fasta}
mv bwamem2/index.0123 bwamem2/index.amb bwamem2/index.ann bwamem2/index.bwt.2bit.64 bwamem2/index.pac {config.out_dir}/reference/bwamem2/
"""

[rules.resources]
threads = 1
memory = "36G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113"

# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_createsequencedictionary"
input = ["{config.fasta}"]
output = ["{config.out_dir}/reference/dict/reference.dict"]
description = "GATK CreateSequenceDictionary for the reference (nf-core GATK4_CREATESEQUENCEDICTIONARY; GATK writes <fasta-basename>.dict, the port renames to reference.dict — see README)"
when = "config.prepare_reference"
log = "logs/gatk_createsequencedictionary.log"
shell = """
mkdir -p {config.out_dir}/reference/dict
DICT=$(basename {config.fasta} | sed 's/\\.[^.]*$//').dict
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" CreateSequenceDictionary --REFERENCE {config.fasta} --URI $(basename {config.fasta}) --TMP_DIR .
mv "$DICT" reference.dict
mv reference.dict {config.out_dir}/reference/dict/
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_faidx"
input = ["{config.fasta}"]
output = ["{config.out_dir}/reference/fai/reference.fasta.fai"]
description = "Samtools faidx index of the reference (nf-core SAMTOOLS_FAIDX; copied to a local name — the original /data path is read-only)"
when = "config.prepare_reference"
log = "logs/samtools_faidx.log"
shell = """
mkdir -p {config.out_dir}/reference/fai
cp -L {config.fasta} ./reference.fasta
samtools faidx reference.fasta
mv reference.fasta.fai {config.out_dir}/reference/fai/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
# FASTQC — nf-core/fastqc module (raw reads QC)
# ---------------------------------------------------------------------------
[[rules]]
name = "fastqc"
input = ["raw/{sample}_R1.fastq.gz", "raw/{sample}_R2.fastq.gz"]
output = [
  "{config.out_dir}/reports/fastqc/{sample}-{config.lane}/{sample}-{config.lane}_1_fastqc.html",
  "{config.out_dir}/reports/fastqc/{sample}-{config.lane}/{sample}-{config.lane}_1_fastqc.zip",
  "{config.out_dir}/reports/fastqc/{sample}-{config.lane}/{sample}-{config.lane}_2_fastqc.html",
  "{config.out_dir}/reports/fastqc/{sample}-{config.lane}/{sample}-{config.lane}_2_fastqc.zip",
]
description = "FastQC quality control on raw reads (nf-core FASTQC, ext.args '--quiet')"
when = "!config.skip_fastqc"
shell = """
mkdir -p {config.out_dir}/reports/fastqc/{sample}-{config.lane}
printf "%s %s\\n" raw/{sample}_R1.fastq.gz {sample}-{config.lane}_1.fastq.gz raw/{sample}_R2.fastq.gz {sample}-{config.lane}_2.fastq.gz | while read old_name new_name; do
    [ -f "$new_name" ] || ln -s $old_name $new_name
done
fastqc --quiet --threads 4 --memory 1024 {sample}-{config.lane}_1.fastq.gz {sample}-{config.lane}_2.fastq.gz
mv {sample}-{config.lane}_1_fastqc.html {sample}-{config.lane}_1_fastqc.zip {sample}-{config.lane}_2_fastqc.html {sample}-{config.lane}_2_fastqc.zip {config.out_dir}/reports/fastqc/{sample}-{config.lane}/
"""

[rules.resources]
threads = 4
memory = "4G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"

# ---------------------------------------------------------------------------
# FASTP — nf-core/fastp module (trim/split; upstream runs when
# params.trim_fastq || params.split_fastq > 0 || params.umi_location)
# ---------------------------------------------------------------------------
[[rules]]
name = "fastp"
input = ["raw/{sample}_R1.fastq.gz", "raw/{sample}_R2.fastq.gz"]
output = [
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R1.fastp.fastq.gz",
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R2.fastp.fastq.gz",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.json",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.html",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.log",
]
description = "Read trimming and splitting (nf-core FASTP; --split_by_lines = 4 x split_fastq)"
when = "(config.trim_fastq || config.split_fastq > 0) && config.umi_read_structure == ''"
shell = """
[ ! -f  {sample}-{config.lane}_R1.fastq.gz ] && ln -sf raw/{sample}_R1.fastq.gz {sample}-{config.lane}_R1.fastq.gz
[ ! -f  {sample}-{config.lane}_R2.fastq.gz ] && ln -sf raw/{sample}_R2.fastq.gz {sample}-{config.lane}_R2.fastq.gz
fastp --in1 {sample}-{config.lane}_R1.fastq.gz --in2 {sample}-{config.lane}_R2.fastq.gz --out1 {sample}-{config.lane}_R1.fastp.fastq.gz --out2 {sample}-{config.lane}_R2.fastp.fastq.gz --json {sample}-{config.lane}.fastp.json --html {sample}-{config.lane}.fastp.html --thread 12 --detect_adapter_for_pe --disable_adapter_trimming --split_by_lines $(({config.split_fastq} * 4)) --length_required {config.length_required} 2> {sample}-{config.lane}.fastp.log
mkdir -p {config.out_dir}/preprocessing/fastp/{sample} {config.out_dir}/reports/fastp/{sample}
mv *.fastp.fastq.gz {config.out_dir}/preprocessing/fastp/{sample}/
mv {sample}-{config.lane}.fastp.json {sample}-{config.lane}.fastp.html {sample}-{config.lane}.fastp.log {config.out_dir}/reports/fastp/{sample}/
"""

[rules.resources]
threads = 12
memory = "4G"

[rules.environment]
conda = "envs/fastp.yaml"

# ---------------------------------------------------------------------------
# UMI consensus preprocessing — upstream subworkflows/local/
# fastq_create_umi_consensus_fgbio (params.umi_read_structure set):
#   FGBIO_FASTQTOBAM -> SAMTOOLS_BAM2FQ_UMI -> BWA_MEM_UMI (unsorted)
#   -> FGBIO_GROUPREADSBYUMI -> FGBIO_CALLMOLECULARCONSENSUSREADS
#   -> SAMTOOLS_BAM2FQ_CONSENSUS -> fastp_umi (same outputs as fastp).
# The upstream BAM_CONVERT_SAMTOOLS step (4-way view -> merge -> collate)
# doubles reads at this commit (no distinguishing -f/-F flags anywhere in
# conf/) — the port uses a single `samtools collate -O | samtools fastq`
# instead (documented deviation, see README).
# ---------------------------------------------------------------------------
[[rules]]
name = "fgbio_fastqtobam"
input = ["raw/{sample}_R1.fastq.gz", "raw/{sample}_R2.fastq.gz"]
output = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}.bam"]
description = "fgbio FastqToBam: tag reads with UMI structures (nf-core FGBIO_FASTQTOBAM, --read-structures from umi_read_structure)"
when = "config.umi_read_structure != ''"
log = "logs/fgbio_fastqtobam.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample}
fgbio -Xmx{effective_memory_mb}m --tmp-dir=. --async-io=true FastqToBam --read-structures {config.umi_read_structure} --input raw/{sample}_R1.fastq.gz raw/{sample}_R2.fastq.gz --output {sample}-{config.lane}.bam --sample {sample}-{config.lane} --library {sample}-{config.lane}
mv {sample}-{config.lane}.bam {config.out_dir}/preprocessing/umi/{sample}/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/fgbio:3.1.2--6e9400d507a9dc55"

# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_bam2fq_umi"
input = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}.bam"]
output = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_interleaved.fq.gz"]
description = "Samtools bam2fq: interleaved reads with RX UMI tags (nf-core SAMTOOLS_BAM2FQ)"
when = "config.umi_read_structure != ''"
log = "logs/samtools_bam2fq_umi.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample}
samtools bam2fq -T RX -@ 1 {input[0]} | bgzip > {sample}-{config.lane}_interleaved.fq.gz
mv {sample}-{config.lane}_interleaved.fq.gz {config.out_dir}/preprocessing/umi/{sample}/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
[[rules]]
name = "bwa_mem_umi"
input = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_interleaved.fq.gz"]
output = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}.umi_unsorted.bam"]
description = "BWA-MEM on UMI-tagged interleaved reads, unsorted (nf-core BWA_MEM with -p -C -Y; ext.args '-K 100000000', no sort step upstream)"
when = "config.umi_read_structure != ''"
log = "logs/bwa_mem_umi.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample}
for f in {config.bwa_index_dir}/*; do [ -f "$f" ] && cp -L "$f" .; done
INDEX=$(find -L ./ -name "*.amb" | head -1 | sed 's/\\.amb$//')
bwa mem -K 100000000 -p -C -Y -R "@RG\\tID:{sample}.{config.lane}\\tPU:{config.lane}\\tSM:{config.patient}_{sample}\\tLB:{sample}\\tDS:{config.fasta}\\tPL:{config.seq_platform}" -t {effective_threads} $INDEX {input[0]} | samtools view -bS -@ {effective_threads} -o {sample}.umi_unsorted.bam -
mv {sample}.umi_unsorted.bam {config.out_dir}/preprocessing/umi/{sample}/
"""

[rules.resources]
threads = 24
memory = "30G"

[rules.environment]
conda = "envs/bwa-samtools.yaml"

# ---------------------------------------------------------------------------
[[rules]]
name = "fgbio_groupreadsbyumi"
input = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}.umi_unsorted.bam"]
output = [
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_umi-grouped.bam",
  "{config.out_dir}/reports/umi/{sample}/{sample}-{config.lane}_umi-grouped_histogram.txt",
  "{config.out_dir}/reports/umi/{sample}/{sample}-{config.lane}_umi-grouped_read-metrics.txt",
]
description = "fgbio GroupReadsByUmi (nf-core FGBIO_GROUPREADSBYUMI, -s from group_by_umi_strategy; grouped BAM is intermediate upstream — the port keeps it under results/ for DAG handoff)"
when = "config.umi_read_structure != ''"
log = "logs/fgbio_groupreadsbyumi.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample} {config.out_dir}/reports/umi/{sample}
fgbio -Xmx{effective_memory_mb}m --tmp-dir=. GroupReadsByUmi -s {config.group_by_umi_strategy} -i {input[0]} -o {sample}-{config.lane}_umi-grouped.bam -f {sample}-{config.lane}_umi-grouped_histogram.txt --grouping-metrics {sample}-{config.lane}_umi-grouped_read-metrics.txt
mv {sample}-{config.lane}_umi-grouped.bam {config.out_dir}/preprocessing/umi/{sample}/
mv {sample}-{config.lane}_umi-grouped_histogram.txt {sample}-{config.lane}_umi-grouped_read-metrics.txt {config.out_dir}/reports/umi/{sample}/
"""

[rules.resources]
threads = 2
memory = "8G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/fgbio:3.1.2--6e9400d507a9dc55"

# ---------------------------------------------------------------------------
[[rules]]
name = "fgbio_callmolecularconsensusreads"
input = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_umi-grouped.bam"]
output = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_umi-consensus.bam"]
description = "fgbio CallMolecularConsensusReads (nf-core FGBIO_CALLMOLECULARCONSENSUSREADS, -S Coordinate --min-reads 1 --min-input-base-quality 10)"
when = "config.umi_read_structure != ''"
log = "logs/fgbio_callmolecularconsensusreads.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample}
fgbio -Xmx{effective_memory_mb}m --tmp-dir=. --async-io=true --compression=1 CallMolecularConsensusReads --input {input[0]} --output {sample}-{config.lane}_umi-consensus.bam --min-reads 1 --min-input-base-quality 10 --threads {effective_threads} -S Coordinate
mv {sample}-{config.lane}_umi-consensus.bam {config.out_dir}/preprocessing/umi/{sample}/
"""

[rules.resources]
threads = 4
memory = "12G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/fgbio:3.1.2--6e9400d507a9dc55"

# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_bam2fq_consensus"
input = ["{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_umi-consensus.bam"]
output = [
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_other.fq.gz",
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_1.fq.gz",
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_2.fq.gz",
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_singleton.fq.gz",
]
description = "Samtools collate + fastq on consensus reads (upstream BAM_CONVERT_SAMTOOLS intent, single collate+fastq — see section note)"
when = "config.umi_read_structure != ''"
log = "logs/samtools_bam2fq_consensus.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/umi/{sample}
samtools collate -@ 1 -O {input[0]} . | samtools fastq -@ 1 -0 {sample}-{config.lane}_other.fq.gz -1 {sample}-{config.lane}_1.fq.gz -2 {sample}-{config.lane}_2.fq.gz -s {sample}-{config.lane}_singleton.fq.gz
mv {sample}-{config.lane}_other.fq.gz {sample}-{config.lane}_1.fq.gz {sample}-{config.lane}_2.fq.gz {sample}-{config.lane}_singleton.fq.gz {config.out_dir}/preprocessing/umi/{sample}/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
# fastp on consensus reads — mirrors the fastp rule (same output paths, so
# bwa_mem downstream is unchanged); upstream runs fastp after UMI consensus
# with the same params.trim_fastq / split_fastq gate.
# ---------------------------------------------------------------------------
[[rules]]
name = "fastp_umi"
input = [
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_1.fq.gz",
  "{config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_2.fq.gz",
]
output = [
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R1.fastp.fastq.gz",
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R2.fastp.fastq.gz",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.json",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.html",
  "{config.out_dir}/reports/fastp/{sample}/{sample}-{config.lane}.fastp.log",
]
description = "Read trimming and splitting of UMI consensus reads (nf-core FASTP on the consensus pair; outputs shared with the fastp rule — the two are mutually exclusive via when)"
when = "(config.trim_fastq || config.split_fastq > 0) && config.umi_read_structure != ''"
log = "logs/fastp_umi.log"
shell = """
[ ! -f {sample}-{config.lane}_R1.fastq.gz ] && ln -sf {config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_1.fq.gz {sample}-{config.lane}_R1.fastq.gz
[ ! -f {sample}-{config.lane}_R2.fastq.gz ] && ln -sf {config.out_dir}/preprocessing/umi/{sample}/{sample}-{config.lane}_2.fq.gz {sample}-{config.lane}_R2.fastq.gz
fastp --in1 {sample}-{config.lane}_R1.fastq.gz --in2 {sample}-{config.lane}_R2.fastq.gz --out1 {sample}-{config.lane}_R1.fastp.fastq.gz --out2 {sample}-{config.lane}_R2.fastp.fastq.gz --json {sample}-{config.lane}.fastp.json --html {sample}-{config.lane}.fastp.html --thread 12 --detect_adapter_for_pe --disable_adapter_trimming --split_by_lines $(({config.split_fastq} * 4)) --length_required {config.length_required} 2> {sample}-{config.lane}.fastp.log
mkdir -p {config.out_dir}/preprocessing/fastp/{sample} {config.out_dir}/reports/fastp/{sample}
mv *.fastp.fastq.gz {config.out_dir}/preprocessing/fastp/{sample}/
mv {sample}-{config.lane}.fastp.json {sample}-{config.lane}.fastp.html {sample}-{config.lane}.fastp.log {config.out_dir}/reports/fastp/{sample}/
"""

[rules.resources]
threads = 12
memory = "4G"

[rules.environment]
conda = "envs/fastp.yaml"

# ---------------------------------------------------------------------------
# BWA_MEM — nf-core/bwa/mem module (aligner 'bwa-mem', upstream default;
# split_fastq > 1 gives prefix "{meta.id}.{first-read-token}")
# ---------------------------------------------------------------------------
[[rules]]
name = "bwa_mem"
input = [
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R1.fastp.fastq.gz",
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R2.fastp.fastq.gz",
]
output = ["{config.out_dir}/preprocessing/mapped/{sample}/{sample}.0001.bam"]
description = "BWA-MEM alignment + coordinate sort (nf-core BWA_MEM, ext.args '-K 100000000 -Y -R <read_group>')"
when = "config.aligner == 'bwa-mem'"
shell = """
mkdir -p {config.out_dir}/preprocessing/mapped/{sample}
for f in {config.bwa_index_dir}/*; do [ -f "$f" ] && cp -L "$f" .; done
INDEX=$(find -L ./ -name "*.amb" | head -1 | sed 's/\\.amb$//')
# {effective_threads} + a bounded per-thread sort buffer: the upstream
# 24-thread label over-subscribes small machines and samtools sort's
# default 768M/thread would request ~18G (live: 'couldn't allocate
# memory for bam_mem' on a 4G box).
bwa mem -K 100000000 -Y -R "@RG\\tID:{sample}.{config.lane}\\tPU:{config.lane}\\tSM:{config.patient}_{sample}\\tLB:{sample}\\tDS:{config.fasta}\\tPL:{config.seq_platform}" -t {effective_threads} $INDEX {input[0]} {input[1]} | samtools sort --threads {effective_threads} -m 512M -o {sample}.0001.bam -
mv {sample}.0001.bam {config.out_dir}/preprocessing/mapped/{sample}/
"""

[rules.resources]
threads = 24
memory = "30G"

[rules.environment]
conda = "envs/bwa-samtools.yaml"

# ---------------------------------------------------------------------------
# BWA_MEM2 — nf-core/bwamem2/mem module (aligner 'bwa-mem2'; same args as
# BWA_MEM, index from bwa_mem2_index_dir; shares bwa_mem's output path so
# all downstream rules are unchanged — the two are mutually exclusive via when)
# ---------------------------------------------------------------------------
[[rules]]
name = "bwa_mem2"
input = [
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R1.fastp.fastq.gz",
  "{config.out_dir}/preprocessing/fastp/{sample}/0001.{sample}-{config.lane}_R2.fastp.fastq.gz",
]
output = ["{config.out_dir}/preprocessing/mapped/{sample}/{sample}.0001.bam"]
description = "BWA-MEM2 alignment + coordinate sort (nf-core BWAMEM2_MEM, ext.args '-K 100000000 -Y -R <read_group>')"
when = "config.aligner == 'bwa-mem2'"
log = "logs/bwa_mem2.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/mapped/{sample}
for f in {config.bwa_mem2_index_dir}/*; do [ -f "$f" ] && cp -L "$f" .; done
INDEX=$(find -L ./ -name "*.amb" | head -1 | sed 's/\\.amb$//')
bwa-mem2 mem -K 100000000 -Y -R "@RG\\tID:{sample}.{config.lane}\\tPU:{config.lane}\\tSM:{config.patient}_{sample}\\tLB:{sample}\\tDS:{config.fasta}\\tPL:{config.seq_platform}" -t {effective_threads} $INDEX {input[0]} {input[1]} | samtools sort --threads {effective_threads} -m 512M -o {sample}.0001.bam -
mv {sample}.0001.bam {config.out_dir}/preprocessing/mapped/{sample}/
"""

[rules.resources]
threads = 24
memory = "30G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113"

# ---------------------------------------------------------------------------
# GATK4_MARKDUPLICATES — nf-core/gatk4/markduplicates module
# (ext.args '--REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT',
# ext.prefix '{meta.id}.md.cram', CRAM conversion via samtools)
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_markduplicates"
input = ["{config.out_dir}/preprocessing/mapped/{sample}/{sample}.0001.bam"]
output = [
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.cram",
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.cram.crai",
  "{config.out_dir}/reports/markduplicates/{sample}/{sample}.md.metrics",
]
description = "Mark duplicates with GATK4 MarkDuplicates and convert to CRAM (nf-core GATK4_MARKDUPLICATES)"
when = "!config.save_output_as_bam"
shell = """
mkdir -p {config.out_dir}/preprocessing/markduplicates/{sample} {config.out_dir}/reports/markduplicates/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" MarkDuplicates --INPUT {input[0]} --OUTPUT {sample}.md.bam --METRICS_FILE {sample}.md.metrics --TMP_DIR . --REFERENCE_SEQUENCE reference.fasta --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT
# CRAM 3.0: the env's samtools 1.24 defaults to CRAM 3.1, which
# GATK 4.5.0.0's bundled htsjdk cannot read (live:
# 'java.lang.RuntimeException: CRAM version 3.1 is not supported'
# in BaseRecalibrator)
samtools view -Ch -T reference.fasta -O cram,version=3.0 -o {sample}.md.cram {sample}.md.bam
rm {sample}.md.bam
samtools index {sample}.md.cram
mv {sample}.md.cram {sample}.md.cram.crai {config.out_dir}/preprocessing/markduplicates/{sample}/
mv {sample}.md.metrics {config.out_dir}/reports/markduplicates/{sample}/
"""

[rules.resources]
threads = 6
memory = "30G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# GATK4_MARKDUPLICATES (BAM branch, params.save_output_as_bam=true) — same
# module with --CREATE_INDEX true; picard writes {sample}.md.bai which is
# renamed to {sample}.md.bam.bai (upstream BAM_MERGE_INDEX_SAMTOOLS). All
# downstream rules consume {config.alignment_ext}-parameterized paths.
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_markduplicates_bam"
input = ["{config.out_dir}/preprocessing/mapped/{sample}/{sample}.0001.bam"]
output = [
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.bam",
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.bam.bai",
  "{config.out_dir}/reports/markduplicates/{sample}/{sample}.md.metrics",
]
description = "Mark duplicates with GATK4 MarkDuplicates, BAM output with index (nf-core GATK4_MARKDUPLICATES, --CREATE_INDEX true; save_output_as_bam=true branch)"
when = "config.save_output_as_bam"
log = "logs/gatk_markduplicates_bam.log"
shell = """
mkdir -p {config.out_dir}/preprocessing/markduplicates/{sample} {config.out_dir}/reports/markduplicates/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" MarkDuplicates --INPUT {input[0]} --OUTPUT {sample}.md.bam --METRICS_FILE {sample}.md.metrics --TMP_DIR . --REFERENCE_SEQUENCE reference.fasta --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --CREATE_INDEX true
mv {sample}.md.bai {sample}.md.bam.bai
mv {sample}.md.bam {sample}.md.bam.bai {config.out_dir}/preprocessing/markduplicates/{sample}/
mv {sample}.md.metrics {config.out_dir}/reports/markduplicates/{sample}/
"""

[rules.resources]
threads = 6
memory = "30G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# CRAM_QC_MOSDEPTH_SAMTOOLS on MarkDuplicates output (nf-core MOSDEPTH +
# SAMTOOLS_STATS; ext.prefix '{meta.id}.md')
# ---------------------------------------------------------------------------
[[rules]]
name = "mosdepth_md"
input = ["{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}"]
output = [
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.md.mosdepth.global.dist.txt",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.md.mosdepth.summary.txt",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.md.regions.bed.gz",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.md.regions.bed.gz.csi",
]
description = "Mosdepth coverage on MarkDuplicates CRAM (ext.args '-n --fast-mode --by 500' for WGS)"
when = "!config.skip_mosdepth"
shell = """
mkdir -p {config.out_dir}/reports/mosdepth/{sample}
cp -L {config.fasta} ./reference.fasta
mosdepth --threads 4 --fasta reference.fasta -n --fast-mode --by 500 {sample}.md {input[0]}
mv {sample}.md.mosdepth.global.dist.txt {sample}.md.mosdepth.summary.txt {sample}.md.regions.bed.gz {sample}.md.regions.bed.gz.csi {config.out_dir}/reports/mosdepth/{sample}/
"""

[rules.resources]
threads = 4
memory = "4G"

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "samtools_stats_md"
input = ["{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}"]
output = ["{config.out_dir}/reports/samtools/{sample}/{sample}.md.{config.alignment_ext}.stats"]
description = "Samtools stats on MarkDuplicates alignment (nf-core SAMTOOLS_STATS, ext.prefix '{meta.id}.md.{alignment_ext}')"
when = "!config.skip_samtools"
shell = """
mkdir -p {config.out_dir}/reports/samtools/{sample}
cp -L {config.fasta} ./reference.fasta
samtools stats --threads 1 --reference reference.fasta {input[0]} > {sample}.md.{config.alignment_ext}.stats
mv {sample}.md.{config.alignment_ext}.stats {config.out_dir}/reports/samtools/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
# GATK4_BASERECALIBRATOR — nf-core/gatk4/baserecalibrator module
# (ext.prefix '{meta.id}.recal'; known-sites = dbsnp + 2 GRCh38 indel sets)
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_baserecalibrator"
input = ["{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}"]
output = ["{config.out_dir}/preprocessing/recal_table/{sample}/{sample}.recal.table"]
description = "Base quality score recalibration table (nf-core GATK4_BASERECALIBRATOR)"
when = "!config.scatter_gatk"
shell = """
mkdir -p {config.out_dir}/preprocessing/recal_table/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
SITES="--known-sites $(basename {config.dbsnp})"
for v in $(echo {config.known_indels} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
    SITES="$SITES --known-sites $(basename "$v")"
done
for v in $(echo {config.known_indels_tbi} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
done
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" BaseRecalibrator --input {input[0]} --output {sample}.recal.table --reference reference.fasta $SITES --tmp-dir .
mv {sample}.recal.table {config.out_dir}/preprocessing/recal_table/{sample}/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# GATK4_APPLYBQSR — nf-core/gatk4/applybqsr module (output_suffix 'cram' since
# save_output_as_bam=false; ext.prefix '{meta.id}.recal')
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_applybqsr"
input = [
  "{config.out_dir}/preprocessing/markduplicates/{sample}/{sample}.md.{config.alignment_ext}",
  "{config.out_dir}/preprocessing/recal_table/{sample}/{sample}.recal.table",
]
output = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
description = "Apply base quality score recalibration to the alignment file (nf-core GATK4_APPLYBQSR)"
when = "!config.scatter_gatk"
shell = """
mkdir -p {config.out_dir}/recalibrated/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" ApplyBQSR --input {input[0]} --output {sample}.recal.{config.alignment_ext} --reference reference.fasta --bqsr-recal-file {input[1]} --tmp-dir .
mv {sample}.recal.{config.alignment_ext} {config.out_dir}/recalibrated/{sample}/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# CRAM_SAMPLEQC on the recalibrated CRAM: SAMTOOLS_INDEX, MOSDEPTH, SAMTOOLS_STATS
# (ext.prefixes '{meta.id}.recal' / '{meta.id}.recal.cram')
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_index_recal"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.recal_index_ext}"]
description = "Index recalibrated alignment file (nf-core SAMTOOLS_INDEX)"
when = "!config.scatter_gatk"
shell = "samtools index -@ 1 {input[0]}"

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "mosdepth_recal"
# the .crai input is the DAG edge to samtools_index_recal — mosdepth
# requires an indexed alignment file, and without this edge it races
# the indexer (live: 'alignment file must be indexed')
input = [
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}",
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.recal_index_ext}",
]
output = [
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.recal.mosdepth.global.dist.txt",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.recal.mosdepth.summary.txt",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.recal.regions.bed.gz",
  "{config.out_dir}/reports/mosdepth/{sample}/{sample}.recal.regions.bed.gz.csi",
]
description = "Mosdepth coverage on recalibrated CRAM (nf-core MOSDEPTH, ext.prefix '{meta.id}.recal')"
when = "!config.skip_mosdepth"
shell = """
mkdir -p {config.out_dir}/reports/mosdepth/{sample}
cp -L {config.fasta} ./reference.fasta
mosdepth --threads 4 --fasta reference.fasta -n --fast-mode --by 500 {sample}.recal {input[0]}
mv {sample}.recal.mosdepth.global.dist.txt {sample}.recal.mosdepth.summary.txt {sample}.recal.regions.bed.gz {sample}.recal.regions.bed.gz.csi {config.out_dir}/reports/mosdepth/{sample}/
"""

[rules.resources]
threads = 4
memory = "4G"

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "samtools_stats_recal"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = ["{config.out_dir}/reports/samtools/{sample}/{sample}.recal.{config.alignment_ext}.stats"]
description = "Samtools stats on recalibrated alignment (nf-core SAMTOOLS_STATS, ext.prefix '{meta.id}.recal.{alignment_ext}')"
when = "!config.skip_samtools"
shell = """
mkdir -p {config.out_dir}/reports/samtools/{sample}
cp -L {config.fasta} ./reference.fasta
samtools stats --threads 1 --reference reference.fasta {input[0]} > {sample}.recal.{config.alignment_ext}.stats
mv {sample}.recal.{config.alignment_ext}.stats {config.out_dir}/reports/samtools/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---------------------------------------------------------------------------
# GATK4_HAPLOTYPECALLER — nf-core/gatk4/haplotypecaller module
# (joint_germline=false => no -ERC GVCF; --pcr-indel-model CONSERVATIVE;
# ext.prefix '{meta.id}.haplotypecaller'; GATK auto-writes the .tbi)
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_haplotypecaller"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz.tbi",
]
description = "Germline variant calling with GATK4 HaplotypeCaller (nf-core GATK4_HAPLOTYPECALLER; joint_germline=false branch — GVCF mode is gatk_haplotypecaller_gvcf)"
when = "config.call_haplotypecaller && !config.joint_germline && !config.scatter_gatk"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" HaplotypeCaller --input {input[0]} --output {sample}.haplotypecaller.vcf.gz --reference reference.fasta --native-pair-hmm-threads 2 --dbsnp $(basename {config.dbsnp}) --tmp-dir . --pcr-indel-model {config.gatk_pcr_indel_model}
mv {sample}.haplotypecaller.vcf.gz {sample}.haplotypecaller.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# VCF_VARIANT_FILTERING_GATK — nf-core gatk4/cnnscorevariants +
# gatk4/filtervarianttranches (upstream runs after HaplotypeCaller on the
# default path; skip_tools 'haplotypecaller_filter' opts out)
# ---------------------------------------------------------------------------
[[rules]]
name = "gatk_cnnscorevariants"
input = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.vcf.gz.tbi",
]
output = [
  "{config.out_dir}/variant_calling/cnnscorevariants/{sample}/{sample}.cnn.vcf.gz",
  "{config.out_dir}/variant_calling/cnnscorevariants/{sample}/{sample}.cnn.vcf.gz.tbi",
]
description = "CNN 1D variant score annotation (nf-core GATK4_CNNSCOREVARIANTS, default --tensor-type 1D; upstream publishDir is disabled — the port keeps this intermediate under results/ for DAG handoff)"
when = "config.call_haplotypecaller && !config.joint_germline"
shell = """
mkdir -p {config.out_dir}/variant_calling/cnnscorevariants/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
# the scoring python runs on the keras TF backend (tensorflow 1.15 in
# envs/gatk4.yaml) — the bundled 1D model loads under TF and
# vqsr_cnn's session API (clear_session/get_session) is TF-only. The
# explicit export matters: a conda keras package's activation script
# sets KERAS_BACKEND=theano on Linux, which breaks the scoring python
# (live nack at K.get_session()).
export KERAS_BACKEND=tensorflow
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" CNNScoreVariants --variant {input[0]} --output {sample}.cnn.vcf.gz --reference reference.fasta --tmp-dir .
mv {sample}.cnn.vcf.gz {sample}.cnn.vcf.gz.tbi {config.out_dir}/variant_calling/cnnscorevariants/{sample}/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

[[rules]]
name = "gatk_filtervarianttranches"
input = [
  "{config.out_dir}/variant_calling/cnnscorevariants/{sample}/{sample}.cnn.vcf.gz",
  "{config.out_dir}/variant_calling/cnnscorevariants/{sample}/{sample}.cnn.vcf.gz.tbi",
]
output = [
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.vcf.gz",
  "{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.vcf.gz.tbi",
]
description = "Tranche filtering of CNN-scored variants (nf-core GATK4_FILTERVARIANTTRANCHES, ext.args '--info-key CNN_1D', ext.prefix '{sample}.haplotypecaller'; known sites as --resource)"
when = "config.call_haplotypecaller && !config.joint_germline"
shell = """
mkdir -p {config.out_dir}/variant_calling/haplotypecaller/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
cp -L {config.dbsnp} {config.dbsnp_tbi} .
SITES="--resource $(basename {config.dbsnp})"
for v in $(echo {config.known_indels} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
    SITES="$SITES --resource $(basename "$v")"
done
for v in $(echo {config.known_indels_tbi} | tr -d '[]"' | tr ',' ' '); do
    cp -L "$v" .
done
gatk --java-options "-Xmx{effective_memory_mb}m -XX:-UsePerfData" FilterVariantTranches --variant {input[0]} $SITES --output {sample}.haplotypecaller.filtered.vcf.gz --tmp-dir . --info-key CNN_1D
mv {sample}.haplotypecaller.filtered.vcf.gz {sample}.haplotypecaller.filtered.vcf.gz.tbi {config.out_dir}/variant_calling/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
conda = "envs/gatk4.yaml"

# ---------------------------------------------------------------------------
# Optional callers — upstream subworkflows/local/bam_variant_calling_*
# (each gated by its call_* boolean; all consume the recalibrated alignment).
# VCF_QC and VEP remain haplotypecaller-scoped (see README fidelity table);
# multiqc depends_on below lists every report producer.
# ---------------------------------------------------------------------------

# FreeBayes germline (upstream BAM_VARIANT_CALLING_FREEBAYES:
# FREEBAYES_GERMLINE -> BCFTOOLS_SORT_FREEBAYES -> TABIX_VC_FREEBAYES
# -> VCFLIB_VCF_FILTER_FREEBAYES -> TABIX_FREEBAYES_FILT)
[[rules]]
name = "freebayes"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.vcf.gz"]
description = "FreeBayes germline variant calling (nf-core FREEBAYES, ext.args '--min-alternate-fraction 0.1 --min-mapping-quality 1'; bgzip'ed in-module)"
when = "config.call_freebayes"
log = "logs/freebayes.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/freebayes/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
freebayes -f reference.fasta --min-alternate-fraction 0.1 --min-mapping-quality 1 {input[0]} > {sample}.vcf
bgzip {sample}.vcf
mv {sample}.vcf.gz {config.out_dir}/variant_calling/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "8G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/freebayes:1.3.10--hbefcdb2_0"

[[rules]]
name = "bcftools_sort_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.vcf.gz"]
description = "Sort FreeBayes VCF with bcftools (nf-core BCFTOOLS_SORT, ext.prefix '{meta.id}.freebayes')"
when = "config.call_freebayes"
log = "logs/bcftools_sort_freebayes.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/freebayes/{sample}
bcftools sort --output {sample}.freebayes.vcf.gz --temp-dir . --output-type z {input[0]}
mv {sample}.freebayes.vcf.gz {config.out_dir}/variant_calling/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "tabix_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.vcf.gz"]
output = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.vcf.gz.tbi"]
description = "Index the sorted FreeBayes VCF (nf-core TABIX_VC_FREEBAYES, bgziptabix compress + tabix)"
when = "config.call_freebayes"
log = "logs/tabix_freebayes.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/freebayes/{sample}
tabix -p vcf -f {sample}.freebayes.vcf.gz
mv {sample}.freebayes.vcf.gz.tbi {config.out_dir}/variant_calling/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "vcffilter_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.vcf.gz"]
output = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
description = "Filter FreeBayes VCF by QUAL (nf-core VCFLIB_VCF_FILTER_FREEBAYES, '--info-filter QUAL > freebayes_filter'; bgzip in-module)"
when = "config.call_freebayes"
log = "logs/vcffilter_freebayes.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/freebayes/{sample}
vcffilter --info-filter 'QUAL > {config.freebayes_filter}' {input[0]} | bgzip -c > {sample}.freebayes.filtered.vcf.gz
mv {sample}.freebayes.filtered.vcf.gz {config.out_dir}/variant_calling/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/vcflib:1.0.14--cc8ffb2c1a080797"

[[rules]]
name = "tabix_freebayes_filt"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
output = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz.tbi"]
description = "Index the filtered FreeBayes VCF (nf-core TABIX_FREEBAYES_FILT)"
when = "config.call_freebayes"
log = "logs/tabix_freebayes_filt.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/freebayes/{sample}
tabix -p vcf -f {sample}.freebayes.filtered.vcf.gz
mv {sample}.freebayes.filtered.vcf.gz.tbi {config.out_dir}/variant_calling/freebayes/{sample}/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/samtools.yaml"

# Strelka2 germline (upstream BAM_VARIANT_CALLING_SINGLE_STRELKA)
[[rules]]
name = "strelka_germline"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.genome.SNP.vcf.gz",
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.genome.SNP.vcf.gz.tbi",
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.genome.INDEL.vcf.gz",
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.genome.INDEL.vcf.gz.tbi",
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.variants.vcf.gz",
  "{config.out_dir}/variant_calling/strelka/{sample}/{sample}.strelka.variants.vcf.gz.tbi",
]
description = "Strelka2 germline variant calling (nf-core STRELKA_GERMLINE; ext.prefix '{meta.id}.strelka'; email-check disabled via sed)"
when = "config.call_strelka"
log = "logs/strelka_germline.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/strelka/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
configureStrelkaGermlineWorkflow.py --bam {input[0]} --referenceFasta reference.fasta --runDir strelka
sed -i s/"isEmail = isLocalSmtp()"/"isEmail = False"/g strelka/runWorkflow.py
python strelka/runWorkflow.py -m local -j {effective_threads}
mv strelka/results/variants/genome.SNP.vcf.gz {sample}.strelka.genome.SNP.vcf.gz
mv strelka/results/variants/genome.SNP.vcf.gz.tbi {sample}.strelka.genome.SNP.vcf.gz.tbi
mv strelka/results/variants/genome.INDEL.vcf.gz {sample}.strelka.genome.INDEL.vcf.gz
mv strelka/results/variants/genome.INDEL.vcf.gz.tbi {sample}.strelka.genome.INDEL.vcf.gz.tbi
mv strelka/results/variants/variants.vcf.gz {sample}.strelka.variants.vcf.gz
mv strelka/results/variants/variants.vcf.gz.tbi {sample}.strelka.variants.vcf.gz.tbi
mv {sample}.strelka.*.vcf.gz* {config.out_dir}/variant_calling/strelka/{sample}/
"""

[rules.resources]
threads = 12
memory = "24G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/strelka:2.9.10--h9ee0642_1"

# Manta germline (upstream BAM_VARIANT_CALLING_GERMLINE_MANTA; only the
# diploid SV calls are published upstream — candidates stay in the workdir)
[[rules]]
name = "manta_germline"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/manta/{sample}/{sample}.manta.diploid_sv.vcf.gz",
  "{config.out_dir}/variant_calling/manta/{sample}/{sample}.manta.diploid_sv.vcf.gz.tbi",
]
description = "Manta germline structural variant calling (nf-core MANTA_GERMLINE; ext.prefix '{meta.id}.manta'; only diploid_sv published upstream)"
when = "config.call_manta"
log = "logs/manta_germline.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/manta/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
cp -L {config.dict} ./reference.dict
configManta.py --bam {input[0]} --reference reference.fasta --runDir manta
python manta/runWorkflow.py -m local -j {effective_threads}
mv manta/results/variants/diploidSV.vcf.gz {sample}.manta.diploid_sv.vcf.gz
mv manta/results/variants/diploidSV.vcf.gz.tbi {sample}.manta.diploid_sv.vcf.gz.tbi
mv {sample}.manta.diploid_sv.vcf.gz* {config.out_dir}/variant_calling/manta/{sample}/
"""

[rules.resources]
threads = 12
memory = "24G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/manta_python:0eb71149179b3920"

# bcftools mpileup + call (upstream BAM_VARIANT_CALLING_MPILEUP; the
# in-module bcftools stats file is not published upstream and stays in the
# workdir here too)
[[rules]]
name = "bcftools_mpileup_call"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/bcftools/{sample}/{sample}.bcftools.vcf.gz",
  "{config.out_dir}/variant_calling/bcftools/{sample}/{sample}.bcftools.vcf.gz.tbi",
]
description = "Germline variant calling with bcftools mpileup + call (nf-core BCFTOOLS_MPILEUP, ext.args '--output-type v --multiallelic-caller', filter 'count(GT==\"RR\")==0')"
when = "config.call_mpileup"
log = "logs/bcftools_mpileup_call.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/bcftools/{sample}
cp -L {config.fasta} ./reference.fasta
echo "{sample}" > sample_name.list
bcftools mpileup --fasta-ref reference.fasta {input[0]} | bcftools call --output-type v --multiallelic-caller | bcftools reheader --samples sample_name.list | bcftools view --output-file {sample}.bcftools.vcf.gz --output-type z -i 'count(GT=="RR")==0'
tabix -p vcf -f {sample}.bcftools.vcf.gz
bcftools stats {sample}.bcftools.vcf.gz > {sample}.bcftools.bcftools_stats.txt
mv {sample}.bcftools.vcf.gz {sample}.bcftools.vcf.gz.tbi {config.out_dir}/variant_calling/bcftools/{sample}/
"""

[rules.resources]
threads = 4
memory = "8G"

[rules.environment]
conda = "envs/bcftools.yaml"

# TIDDIT structural variants (upstream BAM_VARIANT_CALLING_SINGLE_TIDDIT +
# TABIX_BGZIP_TIDDIT_SV; germline runs with --skip_assembly — upstream
# passes an empty bwa index channel)
[[rules]]
name = "tiddit_sv"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/tiddit/{sample}/{sample}.tiddit.vcf",
  "{config.out_dir}/variant_calling/tiddit/{sample}/{sample}.tiddit.ploidies.tab",
]
description = "TIDDIT structural variant calling (nf-core TIDDIT_SV, --skip_assembly for germline; ext.prefix '{meta.id}.tiddit')"
when = "config.call_tiddit"
log = "logs/tiddit_sv.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/tiddit/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
tiddit --sv --skip_assembly --threads {effective_threads} --bam {input[0]} --ref reference.fasta -o {sample}.tiddit
mv {sample}.tiddit.vcf {sample}.tiddit.ploidies.tab {config.out_dir}/variant_calling/tiddit/{sample}/
"""

[rules.resources]
threads = 8
memory = "16G"

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/tiddit:3.9.5--3fb6c287f34e6ab0"

[[rules]]
name = "tabix_tiddit"
input = ["{config.out_dir}/variant_calling/tiddit/{sample}/{sample}.tiddit.vcf"]
output = [
  "{config.out_dir}/variant_calling/tiddit/{sample}/{sample}.tiddit.vcf.gz",
  "{config.out_dir}/variant_calling/tiddit/{sample}/{sample}.tiddit.vcf.gz.tbi",
]
description = "Compress and index the TIDDIT VCF (nf-core TABIX_BGZIP_TIDDIT_SV)"
when = "config.call_tiddit"
log = "logs/tabix_tiddit.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/tiddit/{sample}
bgzip -c -@ 1 {input[0]} > {sample}.tiddit.vcf.gz
tabix -p vcf -f {sample}.tiddit.vcf.gz
mv {sample}.tiddit.vcf.gz {sample}.tiddit.vcf.gz.tbi {config.out_dir}/variant_calling/tiddit/{sample}/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/samtools.yaml"

# goleft indexcov (upstream BAM_VARIANT_CALLING_INDEXCOV, WGS only): per-sample
# samtools reindex (header-only BAM + --write-index pass over /dev/null) then
# the cohort goleft indexcov run. Upstream passes the .crai filter — the port
# reindexes to BAM/BAM-index pairs, so --extranormalize does not apply.
[[rules]]
name = "samtools_reindex_bam"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/indexcov/reindex/{sample}/{sample}.reindex.bam",
  "{config.out_dir}/variant_calling/indexcov/reindex/{sample}/{sample}.reindex.bam.bai",
]
description = "Samtools reindex pass for goleft indexcov (nf-core SAMTOOLS_REINDEX_BAM, args ' -F 3844 -q 30 '; internal — published neither upstream nor here)"
when = "!config.wes && config.call_indexcov"
log = "logs/samtools_reindex_bam.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/indexcov/reindex/{sample}
cp -L {config.fasta} ./reference.fasta
samtools view --header-only --threads 1 -O BAM -o {sample}.reindex.bam --reference reference.fasta {input[0]}
samtools view --uncompressed --write-index --threads 1 -O BAM -o /dev/null##idx##{sample}.reindex.bam.bai --reference reference.fasta -F 3844 -q 30 {input[0]}
mv {sample}.reindex.bam {sample}.reindex.bam.bai {config.out_dir}/variant_calling/indexcov/reindex/{sample}/
"""

[rules.resources]
threads = 1
memory = "2G"

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "goleft_indexcov"
input = []
depends_on = ["samtools_reindex_bam"]
output = [
  "{config.out_dir}/variant_calling/indexcov/indexcov/indexcov-indexcov.bed.gz",
  "{config.out_dir}/variant_calling/indexcov/indexcov/indexcov-indexcov.bed.gz.tbi",
]
description = "Cohort coverage-index with goleft indexcov (nf-core GOLEFT_INDEXCOV, --fai --directory indexcov; WGS only upstream)"
when = "!config.wes && config.call_indexcov"
log = "logs/goleft_indexcov.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/indexcov/indexcov
cp -L {config.fasta_fai} ./reference.fasta.fai
for b in {config.out_dir}/variant_calling/indexcov/reindex/*/*.reindex.bam; do cp -L "$b" .; done
goleft indexcov --fai reference.fasta.fai --directory indexcov -- *.reindex.bam
mv indexcov/indexcov-indexcov.bed.gz indexcov/indexcov-indexcov.bed.gz.tbi {config.out_dir}/variant_calling/indexcov/indexcov/
"""

[rules.resources]
threads = 2
memory = "4G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/goleft:0.2.4--h9ee0642_1"

# DeepVariant (upstream BAM_VARIANT_CALLING_DEEPVARIANT; WGS model)
[[rules]]
name = "deepvariant"
input = ["{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}"]
output = [
  "{config.out_dir}/variant_calling/deepvariant/{sample}/{sample}.deepvariant.vcf.gz",
  "{config.out_dir}/variant_calling/deepvariant/{sample}/{sample}.deepvariant.vcf.gz.tbi",
  "{config.out_dir}/variant_calling/deepvariant/{sample}/{sample}.deepvariant.g.vcf.gz",
  "{config.out_dir}/variant_calling/deepvariant/{sample}/{sample}.deepvariant.g.vcf.gz.tbi",
]
description = "DeepVariant germline variant calling (nf-core RUNDEEPVARIANT, --model_type WGS, ext.prefix '{meta.id}.deepvariant')"
when = "config.call_deepvariant"
log = "logs/deepvariant.log"
shell = """
mkdir -p {config.out_dir}/variant_calling/deepvariant/{sample}
cp -L {config.fasta} ./reference.fasta
cp -L {config.fasta_fai} ./reference.fasta.fai
export MPLCONFIGDIR=$PWD/.matplotlib
mkdir -p $MPLCONFIGDIR
/opt/deepvariant/bin/run_deepvariant --ref=reference.fasta --reads={input[0]} --output_vcf={sample}.deepvariant.vcf.gz --output_gvcf={sample}.deepvariant.g.vcf.gz --model_type=WGS --sample_name {sample} --intermediate_results_dir=tmp --num_shards={effective_threads}
mv {sample}.deepvariant.vcf.gz {sample}.deepvariant.vcf.gz.tbi {sample}.deepvariant.g.vcf.gz {sample}.deepvariant.g.vcf.gz.tbi {config.out_dir}/variant_calling/deepvariant/{sample}/
"""

[rules.resources]
threads = 16
memory = "32G"

[rules.environment]
singularity = "docker://docker.io/google/deepvariant:1.10.0"

# ---------------------------------------------------------------------------
# NGSCheckMate (upstream subworkflows/nf-core/bam_ngscheckmate: per-sample
# BCFTOOLS_MPILEUP -> cohort NGSCHECKMATE_NCM)
# ---------------------------------------------------------------------------
[[rules]]
name = "bcftools_mpileup_ngscheckmate"
input = [
  "{config.out_dir}/recalibrated/{sample}/{sample}.recal.{config.alignment_ext}",
  "{config.ngscheckmate_bed}",
]
output = [
  "{config.out_dir}/reports/ngscheckmate/vcfs/{sample}-{config.lane}.ngscheckmate.vcf.gz",
  "{config.out_dir}/reports/ngscheckmate/vcfs/{sample}-{config.lane}.ngscheckmate.vcf.gz.tbi",
  "{config.out_dir}/reports/ngscheckmate/vcfs/{sample}-{config.lane}.ngscheckmate.bcftools_stats.txt",
]
description = "Per-sample VCFs for NGSCheckMate (nf-core BCFTOOLS_MPILEUP with args2 '--no-version --ploidy 1 -c', args3 '--no-version'; targets = ngscheckmate SNP bed; ext.prefix '{meta.id}.ngscheckmate')"
when = "config.tools_ngscheckmate"
log = "logs/bcftools_mpileup_ngscheckmate.log"
shell = """
mkdir -p {config.out_dir}/reports/ngscheckmate/vcfs
cp -L {config.fasta} ./reference.fasta
cp -L {config.ngscheckmate_bed} ./snp.bed
echo "{sample}-{config.lane}" > sample_name.list
bcftools mpileup --fasta-ref reference.fasta -T snp.bed {input[0]} | bcftools call --output-type v --no-version --ploidy 1 -c | bcftools reheader --samples sample_name.list | bcftools view --output-file {sample}-{config.lane}.ngscheckmate.vcf.gz --output-type z --no-version
tabix -p vcf -f {sample}-{config.lane}.ngscheckmate.vcf.gz
bcftools stats {sample}-{config.lane}.ngscheckmate.vcf.gz > {sample}-{config.lane}.ngscheckmate.bcftools_stats.txt
mv {sample}-{config.lane}.ngscheckmate.vcf.gz {sample}-{config.lane}.ngscheckmate.vcf.gz.tbi {sample}-{config.lane}.ngscheckmate.bcftools_stats.txt {config.out_dir}/reports/ngscheckmate/vcfs/
"""

[rules.resources]
threads = 4
memory = "8G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "ngscheckmate_ncm"
input = []
depends_on = ["bcftools_mpileup_ngscheckmate"]
output = [
  "{config.out_dir}/reports/ngscheckmate/ngscheckmate_corr_matrix.txt",
  "{config.out_dir}/reports/ngscheckmate/ngscheckmate_matched.txt",
  "{config.out_dir}/reports/ngscheckmate/ngscheckmate_all.txt",
]
description = "Cohort NGSCheckMate cross-sample concordance (nf-core NGSCHECKMATE_NCM; ncm.py with NCM_REF, -bed SNP bed, -N ngscheckmate -V)"
when = "config.tools_ngscheckmate"
log = "logs/ngscheckmate_ncm.log"
shell = """
mkdir -p {config.out_dir}/reports/ngscheckmate
cp -L {config.fasta} ./reference.fasta
cp -L {config.ngscheckmate_bed} ./snp.bed
for v in {config.out_dir}/reports/ngscheckmate/vcfs/*.ngscheckmate.vcf.gz; do gunzip -k "$v"; done
export NCM_REF=./reference.fasta
ncm.py -d . -bed snp.bed -O . -N ngscheckmate -V
mv ngscheckmate_corr_matrix.txt ngscheckmate_matched.txt ngscheckmate_all.txt {config.out_dir}/reports/ngscheckmate/
"""

[rules.resources]
threads = 1
memory = "4G"

[rules.environment]
singularity = "docker://quay.io/biocontainers/ngscheckmate:1.0.1--py312pl5321h577a1d6_4"

# ---------------------------------------------------------------------------
# VCF_QC_BCFTOOLS_VCFTOOLS — nf-core bcftools/stats + vcftools (x3)
# (ext.prefix = vcf basename minus '.vcf' = '{meta.id}.haplotypecaller.filtered')
# ---------------------------------------------------------------------------
[[rules]]
name = "bcftools_stats"
input = ["{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.vcf.gz"]
output = ["{config.out_dir}/reports/bcftools/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.bcftools_stats.txt"]
description = "VCF QC stats with bcftools on the filtered VCF (nf-core BCFTOOLS_STATS)"
when = "config.call_haplotypecaller && !config.joint_germline && !config.skip_bcftools"
shell = """
mkdir -p {config.out_dir}/reports/bcftools/haplotypecaller/{sample}
bcftools stats {input[0]} > {sample}.haplotypecaller.filtered.bcftools_stats.txt
mv {sample}.haplotypecaller.filtered.bcftools_stats.txt {config.out_dir}/reports/bcftools/haplotypecaller/{sample}/
"""

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "vcftools_tstv_count"
input = ["{config.out_dir}/variant_calling/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.vcf.gz"]
output = ["{config.out_dir}/reports/vcftools/haplotypecaller/{sample}/{sample}.haplotypecaller.filtered.TsTv.count"]
description = "VCF QC: transition/transversion by count on the filtered VCF (nf-core VCFTOOLS_TSTV_COUNT)"
when = "config.call_haplotypecaller && !config.joint_germline && !config.skip_vcftools"
shell = """
mkdir -p {config.out_dir}/reports/vcftools/haplotypecaller/{sample}
vcftools --gzvcf {input[0]} --TsTv-by-count --out {sample}.haplotypecaller.filtered
mv {sample}.haplotypecaller.filtered.TsTv.count {config.out_dir}/reports/vcftools/haplotypecaller/{sample}/
"""

