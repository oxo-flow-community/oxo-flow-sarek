[[rules]]
name = "ensemblvep_vep_freebayes"
input = ["{config.out_dir}/variant_calling/freebayes/{sample}/{sample}.freebayes.filtered.vcf.gz"]
output = [
  "{config.out_dir}/annotation/freebayes/{sample}/{sample}.freebayes.filtered_VEP.ann.vcf.gz",
